## 4. 错误处理规范

### 统一异常类
**位置**: `backend/app/core/exceptions.py`

```python
class BusinessError(Exception):
    """业务逻辑错误"""
    def __init__(self, message: str, code: str = "BUSINESS_ERROR"):
        self.message = message
        self.code = code
        super().__init__(self.message)

class NotFoundError(BusinessError):
    """资源不存在"""
    def __init__(self, message: str):
        super().__init__(message, "NOT_FOUND")

class ValidationError(BusinessError):
    """验证错误"""
    def __init__(self, message: str):
        super().__init__(message, "VALIDATION_ERROR")
```

### Service层抛出业务异常

```python
# ✅ 正确: Service层抛出业务异常
class RoadmapService:
    async def get_by_id(
        self,
        db: AsyncSession,
        roadmap_id: str
    ) -> RoadmapResponse:
        roadmap = await roadmap_crud.get_by_id(db, roadmap_id)
        
        if not roadmap:
            raise NotFoundError(f"路线图 {roadmap_id} 不存在")
        
        return RoadmapResponse.model_validate(roadmap)
```

### API层捕获并转换为HTTP响应

```python
# ✅ 正确: API层捕获业务异常
@router.get("/roadmaps/{roadmap_id}")
async def get_roadmap(
    roadmap_id: str,
    db: CurrentSession
) -> ResponseModel:
    try:
        roadmap = await roadmap_service.get_by_id(db, roadmap_id)
        return ResponseModel(success=True, data=roadmap)
    except NotFoundError as e:
        raise HTTPException(status_code=404, detail=str(e))
    except BusinessError as e:
        raise HTTPException(status_code=400, detail=str(e))
```

### Celery任务错误处理

```python
# ✅ 使用 @safe_task 装饰器统一处理异常
from app.core.celery_decorators import safe_task

@celery_app.task(name="my_task")
@safe_task
async def my_task(data: dict):
    """异步任务(自动捕获异常并记录)"""
    # 任务逻辑
    result = await do_something(data)
    return result
```

