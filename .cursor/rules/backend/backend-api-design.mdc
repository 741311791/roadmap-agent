## 4. 统一响应格式

### ResponseModel定义

**位置**: `backend/app/schemas/response.py`

```python
from pydantic import BaseModel, Field
from datetime import datetime
from typing import Any, Generic, TypeVar

T = TypeVar('T')

class ResponseModel(BaseModel):
    """统一响应模型"""
    success: bool = Field(description="请求是否成功")
    message: str = Field(description="响应消息")
    data: Any | None = Field(None, description="响应数据")
    timestamp: datetime = Field(
        default_factory=datetime.utcnow,
        description="响应时间戳"
    )

class ResponseModelGeneric(BaseModel, Generic[T]):
    """泛型响应模型(带类型提示)"""
    success: bool
    message: str
    data: T | None = None
    timestamp: datetime = Field(default_factory=datetime.utcnow)
```

### 使用示例

```python
from app.schemas.response import ResponseModel
from app.schemas.roadmap import RoadmapDetailResponse

# ✅ 成功响应
@router.get("/roadmaps/{roadmap_id}")
async def get_roadmap(
    roadmap_id: str,
    db: CurrentSession
) -> ResponseModel:
    """获取路线图详情"""
    roadmap = await roadmap_service.get_by_id(db, roadmap_id)
    
    if not roadmap:
        raise HTTPException(
            status_code=404,
            detail=f"Roadmap {roadmap_id} not found"
        )
    
    return ResponseModel(
        success=True,
        message="Roadmap retrieved successfully",
        data=roadmap
    )

# ✅ 创建成功响应
@router.post("/roadmaps")
async def create_roadmap(
    obj: CreateRoadmapRequest,
    db: CurrentSessionTransaction
) -> ResponseModel:
    roadmap = await roadmap_service.create(db, obj)
    
    return ResponseModel(
        success=True,
        message="Roadmap created successfully",
        data={"roadmap_id": roadmap.roadmap_id}
    )

# ✅ 列表响应(带分页)
@router.get("/roadmaps")
async def list_roadmaps(
    page: int = 1,
    size: int = 20,
    db: CurrentSession
) -> ResponseModel:
    roadmaps = await roadmap_service.get_list(db, page, size)
    total = await roadmap_service.count(db)
    
    return ResponseModel(
        success=True,
        message="Roadmaps retrieved successfully",
        data={
            "items": roadmaps,
            "total": total,
            "page": page,
            "size": size,
            "pages": (total + size - 1) // size
        }
    )
```

