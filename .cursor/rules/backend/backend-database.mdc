### 索引设计规范

```python
from sqlalchemy import Index

class RoadmapMetadata(Base):
    __tablename__ = "roadmap_metadata"
    
    # 方式1: 在字段定义时添加索引
    roadmap_id: Mapped[str] = mapped_column(
        String(64),
        index=True,  # 单列索引
        unique=True  # 唯一索引
    )
    
    # 方式2: 在表级别定义复合索引
    __table_args__ = (
        Index(
            "idx_user_status",
            "user_id",
            "status"
        ),
        Index(
            "idx_created_at_desc",
            "created_at",
            postgresql_using="btree",
            postgresql_order_by="created_at DESC"
        ),
    )
