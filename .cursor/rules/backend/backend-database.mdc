## 2. CRUD模式规范

### CRUD文件命名

**规则**: `crud_<model>.py`

**示例**:
- `crud_user.py` - 用户CRUD
- `crud_roadmap.py` - 路线图CRUD
- `crud_task.py` - 任务CRUD
- `crud_tutorial.py` - 教程CRUD

### CRUD基类

**位置**: `backend/app/crud/base.py`

```python
from typing import Generic, TypeVar
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

ModelT = TypeVar("ModelT")

class CRUDBase(Generic[ModelT]):
    """
    CRUD基类
    
    提供通用的CRUD方法,所有CRUD类应继承此基类
    """
    
    def __init__(self, model: type[ModelT]):
        """
        初始化CRUD
        
        Args:
            model: SQLAlchemy模型类
        """
        self.model = model
    
    async def get_by_id(
        self,
        db: AsyncSession,
        id: int
    ) -> ModelT | None:
        """根据ID查询"""
        return await db.get(self.model, id)
    
    async def get_list(
        self,
        db: AsyncSession,
        skip: int = 0,
        limit: int = 20
    ) -> list[ModelT]:
        """查询列表(带分页)"""
        stmt = select(self.model).offset(skip).limit(limit)
        result = await db.execute(stmt)
        return result.scalars().all()
    
    async def create(
        self,
        db: AsyncSession,
        obj: dict | object
    ) -> ModelT:
        """创建记录"""
        if hasattr(obj, "model_dump"):
            data = obj.model_dump()
        else:
            data = obj
        
        new_obj = self.model(**data)
        db.add(new_obj)
        await db.flush()  # ⭐ 只flush,不commit
        return new_obj
    
    async def update(
        self,
        db: AsyncSession,
        id: int,
        obj: dict | object
    ) -> ModelT | None:
        """更新记录"""
        db_obj = await self.get_by_id(db, id)
        if not db_obj:
            return None
        
        if hasattr(obj, "model_dump"):
            update_data = obj.model_dump(exclude_unset=True)
        else:
            update_data = obj
        
        for key, value in update_data.items():
            setattr(db_obj, key, value)
        
        await db.flush()  # ⭐ 只flush,不commit
        return db_obj
    
    async def delete(
        self,
        db: AsyncSession,
        id: int
    ) -> bool:
        """删除记录"""
        db_obj = await self.get_by_id(db, id)
        if not db_obj:
            return False
        
        await db.delete(db_obj)
        await db.flush()  # ⭐ 只flush,不commit
        return True
```

### CRUD实现示例

```python
# backend/app/crud/crud_roadmap.py
from sqlalchemy import select, and_, or_, func
from sqlalchemy.ext.asyncio import AsyncSession
from app.crud.base import CRUDBase
from app.models.database import RoadmapMetadata
from app.schemas.roadmap import CreateRoadmapSchema

class CRUDRoadmap(CRUDBase[RoadmapMetadata]):
    """路线图元数据CRUD"""
    
    async def get_by_roadmap_id(
        self,
        db: AsyncSession,
        roadmap_id: str
    ) -> RoadmapMetadata | None:
        """根据roadmap_id查询"""
        stmt = select(self.model).where(
            self.model.roadmap_id == roadmap_id
        )
        result = await db.execute(stmt)
        return result.scalar_one_or_none()
    
    async def get_user_roadmaps(
        self,
        db: AsyncSession,
        user_id: str,
        skip: int = 0,
        limit: int = 20,
        status: str | None = None,
        keyword: str | None = None
    ) -> list[RoadmapMetadata]:
        """
        查询用户的路线图列表
        
        Args:
            db: 数据库Session
            user_id: 用户ID
            skip: 跳过数量(分页)
            limit: 返回数量
            status: 状态过滤(可选)
            keyword: 关键词搜索(可选)
            
        Returns:
            路线图列表
        """
        # 构建查询条件
        conditions = [self.model.user_id == user_id]
        
        if status:
            conditions.append(self.model.status == status)
        
        if keyword:
            conditions.append(
                or_(
                    self.model.title.ilike(f"%{keyword}%"),
                    self.model.description.ilike(f"%{keyword}%")
                )
            )
        
        # 执行查询
        stmt = (
            select(self.model)
            .where(and_(*conditions))
            .order_by(self.model.created_at.desc())
            .offset(skip)
            .limit(limit)
        )
        result = await db.execute(stmt)
        return result.scalars().all()
    
    async def count_user_roadmaps(
        self,
        db: AsyncSession,
        user_id: str,
        status: str | None = None
    ) -> int:
        """统计用户路线图数量"""
        conditions = [self.model.user_id == user_id]
        
        if status:
            conditions.append(self.model.status == status)
        
        stmt = select(func.count()).where(and_(*conditions))
        result = await db.execute(stmt)
        return result.scalar_one()
    
    async def bulk_create(
        self,
        db: AsyncSession,
        objs: list[CreateRoadmapSchema]
    ) -> list[RoadmapMetadata]:
        """
        批量创建
        
        Args:
            db: 数据库Session
            objs: 创建对象列表
            
        Returns:
            创建的实例列表
        """
        instances = [
            self.model(**obj.model_dump())
            for obj in objs
        ]
        db.add_all(instances)
        await db.flush()  # ⭐ flush获取生成的ID
        return instances
    
    async def update_status(
        self,
        db: AsyncSession,
        roadmap_id: str,
        status: str
    ) -> RoadmapMetadata | None:
        """更新路线图状态"""
        roadmap = await self.get_by_roadmap_id(db, roadmap_id)
        if not roadmap:
            return None
        
        roadmap.status = status
        await db.flush()
        return roadmap

# ============ 工厂函数 ============
def get_roadmap_crud() -> CRUDRoadmap:
    """获取CRUD实例"""
    return CRUDRoadmap(RoadmapMetadata)
```

### CRUD使用规范

```python
# ✅ 正确: 在Service层使用CRUD
class RoadmapService:
    @staticmethod
    async def get_by_id(
        db: AsyncSession,
