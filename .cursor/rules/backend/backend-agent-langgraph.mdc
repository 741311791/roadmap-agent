### Prompt加载示例

```python
# 在Agent的execute方法中
async def execute(self, input_data: MyInput) -> MyOutput:
    # 加载Prompt模板
    prompt = await self.load_prompt(
        "my_agent.j2",
        agent_name="我的Agent",
        role_description="分析和处理数据",
        user_goal=input_data.goal,
        execution_history=["步骤1完成", "步骤2完成"],
        current_step="当前步骤",
        constraints="必须遵守的约束条件",
        input_data=input_data.model_dump(),
        output_schema=MyOutput.model_json_schema(),
    )
    
    # 调用LLM
    response = await self.call_llm(prompt)
    
    # 解析输出
    return MyOutput.model_validate_json(response)
```

