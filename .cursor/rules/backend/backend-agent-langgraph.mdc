### Node Runner开发规范

**职责划分**:
- ✅ Runner负责: 执行Agent、返回纯结果
- ✅ WorkflowBrain负责: 状态管理、数据库操作、日志通知

**标准模板**:
```python
# backend/app/core/orchestrator/node_runners/my_runner.py
from app.core.orchestrator.base import RoadmapState
from app.core.orchestrator.workflow_brain import WorkflowBrain

async def my_runner(
    state: RoadmapState,
    brain: WorkflowBrain
) -> dict:
    """
    自定义节点执行器
    
    Args:
        state: LangGraph状态
        brain: 工作流大脑(负责状态管理和持久化)
        
    Returns:
        状态更新字典
    """
    # 使用Brain的上下文管理器(自动处理日志、通知、错误)
    async with brain.node_execution("my_node", state):
        # 1. 创建Agent
        agent = brain.agent_factory.create_my_agent()
        
        # 2. 执行Agent
        result = await agent.execute(state["user_request"])
        
        # 3. 保存结果(使用Brain的统一事务)
        await brain.save_my_result(
            task_id=state["task_id"],
            result=result,
        )
        
        # 4. 返回状态更新
        return {
            "my_result": result,
            "current_step": "my_node",
        }
```

**错误示例**:
```python
# ❌ 错误: Runner不应该直接操作数据库
async def bad_runner(state: RoadmapState) -> dict:
    agent = MyAgent()
    result = await agent.execute(state["user_request"])
    
    # ❌ 不应该在Runner中直接操作数据库
    async with async_session_maker() as db:
        await crud.create(db, result)
        await db.commit()
    
    return {"result": result}

# ❌ 错误: Runner不应该处理通知
async def bad_runner2(state: RoadmapState) -> dict:
    result = await agent.execute(state["user_request"])
    
    # ❌ 不应该在Runner中发送通知
    await notification_service.publish(
        task_id=state["task_id"],
        message="步骤完成"
    )
    
    return {"result": result}
```

