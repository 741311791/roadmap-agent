## 5. 工作流构建规范

### 工作流图构建

**位置**: `backend/app/core/orchestrator/builder.py`

```python
from langgraph.graph import StateGraph, END

def build_roadmap_workflow(brain: WorkflowBrain) -> StateGraph:
    """构建路线图生成工作流"""
    workflow = StateGraph(RoadmapState)
    
    # 1. 添加节点
    workflow.add_node("intent_analysis", lambda s: intent_runner(s, brain))
    workflow.add_node("curriculum_design", lambda s: curriculum_runner(s, brain))
    workflow.add_node("validation", lambda s: validation_runner(s, brain))
    workflow.add_node("roadmap_edit", lambda s: editor_runner(s, brain))
    workflow.add_node("human_review", lambda s: review_runner(s, brain))
    workflow.add_node("content_generation", lambda s: content_runner(s, brain))
    
    # 2. 设置入口
    workflow.set_entry_point("intent_analysis")
    
    # 3. 添加边
    workflow.add_edge("intent_analysis", "curriculum_design")
    workflow.add_edge("curriculum_design", "validation")
    workflow.add_edge("roadmap_edit", "validation")
    
    # 4. 添加条件路由
    workflow.add_conditional_edges(
        "validation",
        route_after_validation,
        {
            "human_review": "human_review",
            "roadmap_edit": "roadmap_edit",
        }
    )
    
    workflow.add_conditional_edges(
        "human_review",
        route_after_review,
        {
            "approved": "content_generation",
            "rejected": "roadmap_edit",
        }
    )
    
    workflow.add_edge("content_generation", END)
    
    return workflow.compile()
```

