## 6. 代码风格规范

### 导入顺序

```python
# ✅ 正确的导入顺序

# 1. 标准库(按字母顺序)
import time
from contextlib import asynccontextmanager
from datetime import datetime
from typing import TYPE_CHECKING, Annotated

# 2. 第三方库(按字母顺序)
from fastapi import APIRouter, Depends, HTTPException
from pydantic import BaseModel, Field
from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession
import structlog

# 3. 本地导入(按层级顺序: config → db → models → schemas → crud → services → api)
from app.config.settings import settings
from app.db.session import CurrentSession, CurrentSessionTransaction
from app.models.database import RoadmapMetadata
from app.schemas.roadmap import CreateRoadmapRequest, RoadmapResponse
from app.crud.crud_roadmap import get_roadmap_crud
from app.services.roadmaps.roadmap_service import RoadmapService

# ❌ 错误: 导入顺序混乱
from app.models.database import RoadmapMetadata  # 应该在后面
import time  # 应该在最前
from fastapi import APIRouter  # 应该在中间
```

