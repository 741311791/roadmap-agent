{
    "vector_store": {
        "provider": "pgvector",
        "config": {
            "collection_name": "mentor_memories",
            "embedding_model_dims": 1024,
            "connection_string": "postgresql://USER:PASSWORD@HOST:5432/DATABASE"
        }
    },
    "llm": {
        "provider": "openai",
        "config": {
            "model": "deepseek/deepseek-v3.2",
            "api_key": "YOUR_LLM_API_KEY",
            "openai_base_url": "https://api.example.com/v1"
        }
    },
    "embedder": {
        "provider": "openai",
        "config": {
            "model": "bailian/text-embedding-v4",
            "embedding_dims": 1024,
            "api_key": "YOUR_EMBEDDING_API_KEY",
            "openai_base_url": "https://api.example.com/v1"
        }
    },
    "custom_fact_extraction_prompt": "在此填写事实提取 Prompt，或通过代码/环境变量覆盖。",
    "custom_update_memory_prompt": "在此填写记忆更新 Prompt，或通过代码/环境变量覆盖。"
}
